{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private user account profile, personal settings, currency, timezone, and dashboard layout preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "roleTitle": { "type": "string", "maxLength": 100 },
        "theme": { "type": "string", "enum": ["dark", "light"] },
        "currency": { "type": "string", "enum": ["INR", "USD", "EUR", "GBP", "JPY", "AUD", "CAD", "SGD"] },
        "dateFormat": { "type": "string", "enum": ["DD/MM/YYYY", "MM/DD/YYYY", "YYYY-MM-DD"] },
        "timezone": { "type": "string", "maxLength": 80 },
        "language": { "type": "string", "maxLength": 20 },
        "weatherCity": { "type": "string", "maxLength": 100 },
        "notificationsEnabled": { "type": "boolean" },
        "widgetOrder": { "type": "array" },
        "hiddenWidgets": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "theme", "currency", "createdAt", "updatedAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Actionable user task with priority, subtasks, recurrence, tags, and status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "description": { "type": "string", "maxLength": 4000 },
        "status": { "type": "string", "enum": ["todo", "in_progress", "done"] },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
        "category": { "type": "string", "maxLength": 60 },
        "tags": { "type": "array" },
        "dueDate": { "type": "string", "maxLength": 40 },
        "dueTime": { "type": "string", "maxLength": 20 },
        "recurrence": { "type": "string", "enum": ["none", "daily", "weekly", "monthly"] },
        "reminderAt": { "type": "string", "maxLength": 40 },
        "subtasks": { "type": "array" },
        "order": { "type": "number" },
        "completedAt": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "status", "priority", "createdAt", "updatedAt"]
    },
    "CalendarEvent": {
      "title": "CalendarEvent",
      "description": "Scheduled calendar event with category color, duration, recurrence, and reminders.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "startDate": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 10 },
        "durationMinutes": { "type": "number" },
        "category": { "type": "string", "enum": ["work", "personal", "health", "finance", "learning"] },
        "recurrence": { "type": "string", "enum": ["none", "daily", "weekly", "monthly"] },
        "reminderMinutes": { "type": "number" },
        "location": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "startDate", "startTime", "durationMinutes", "category", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Manual income or expense ledger entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "type": { "type": "string", "enum": ["income", "expense"] },
        "amount": { "type": "number" },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "description": { "type": "string", "maxLength": 300 },
        "paymentMethod": { "type": "string", "maxLength": 60 },
        "date": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "amount", "category", "paymentMethod", "date", "createdAt", "updatedAt"]
    },
    "Budget": {
      "title": "Budget",
      "description": "Monthly spending cap per category or overall.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "month": { "type": "string", "maxLength": 10 },
        "limit": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "category", "month", "limit", "createdAt", "updatedAt"]
    },
    "SavingsGoal": {
      "title": "SavingsGoal",
      "description": "Financial savings target with current saved balance.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "targetAmount": { "type": "number" },
        "currentAmount": { "type": "number" },
        "targetDate": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "targetAmount", "currentAmount", "createdAt", "updatedAt"]
    },
    "Note": {
      "title": "Note",
      "description": "Rich structured note with folder, tags, checklist items, pinning, and archiving.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 240 },
        "content": { "type": "string", "maxLength": 50000 },
        "folder": { "type": "string", "maxLength": 80 },
        "tags": { "type": "array" },
        "pinned": { "type": "boolean" },
        "favorite": { "type": "boolean" },
        "archived": { "type": "boolean" },
        "attachments": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "content", "folder", "pinned", "favorite", "archived", "createdAt", "updatedAt"]
    },
    "Habit": {
      "title": "Habit",
      "description": "Custom daily/weekly habit definition with target frequency.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "category": { "type": "string", "maxLength": 60 },
        "frequency": { "type": "string", "enum": ["daily", "weekly"] },
        "targetPerWeek": { "type": "number" },
        "color": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "frequency", "targetPerWeek", "createdAt", "updatedAt"]
    },
    "HabitRecord": {
      "title": "HabitRecord",
      "description": "Daily completion record for a habit.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "habitId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 20 },
        "completed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "habitId", "date", "completed", "createdAt", "updatedAt"]
    },
    "FocusSession": {
      "title": "FocusSession",
      "description": "Completed or logged Pomodoro focus/break session.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "mode": { "type": "string", "enum": ["focus", "short_break", "long_break"] },
        "durationMinutes": { "type": "number" },
        "taskId": { "type": "string", "maxLength": 128 },
        "taskTitle": { "type": "string", "maxLength": 240 },
        "completedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "mode", "durationMinutes", "completedAt", "createdAt"]
    },
    "Goal": {
      "title": "Goal",
      "description": "Personal or professional goal with horizon, milestones, and progress.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "horizon": { "type": "string", "enum": ["daily", "weekly", "monthly", "yearly", "long_term"] },
        "targetDate": { "type": "string", "maxLength": 20 },
        "progress": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "completed", "paused"] },
        "milestones": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "horizon", "progress", "status", "createdAt", "updatedAt"]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "In-app notification entry for reminders, deadlines, and insights.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "message": { "type": "string", "maxLength": 500 },
        "category": { "type": "string", "enum": ["task", "event", "finance", "habit", "system"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "message", "category", "read", "createdAt"]
    },
    "AiConversation": {
      "title": "AiConversation",
      "description": "Persisted DAYFLOW AI assistant conversation history.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "messages": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "messages", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and workspace settings strictly isolated to the owner."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User tasks isolated under the owner's user document."
    },
    "/users/{userId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/CalendarEvent" },
      "description": "User calendar events isolated under the owner's user document."
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/Transaction" },
      "description": "User manual finance transactions."
    },
    "/users/{userId}/budgets/{budgetId}": {
      "schema": { "$ref": "#/entities/Budget" },
      "description": "User monthly category budgets."
    },
    "/users/{userId}/savingsGoals/{savingsGoalId}": {
      "schema": { "$ref": "#/entities/SavingsGoal" },
      "description": "User savings goals."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "User notes and structured documents."
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": { "$ref": "#/entities/Habit" },
      "description": "User habit definitions."
    },
    "/users/{userId}/habitRecords/{recordId}": {
      "schema": { "$ref": "#/entities/HabitRecord" },
      "description": "User daily habit completion records."
    },
    "/users/{userId}/focusSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/FocusSession" },
      "description": "User Pomodoro focus sessions."
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": { "$ref": "#/entities/Goal" },
      "description": "User personal and professional goals."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "User workspace notifications."
    },
    "/users/{userId}/aiConversations/{conversationId}": {
      "schema": { "$ref": "#/entities/AiConversation" },
      "description": "User DAYFLOW AI conversation threads."
    }
  }
}
